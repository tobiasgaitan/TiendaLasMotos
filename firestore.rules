rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers WEB-038 — rol desde sys_admin_users por email canónico.
    function emailActual() {
      return request.auth.token.email.lower();
    }

    function rolActual() {
      return get(
        /databases/$(database)/documents/sys_admin_users/$(emailActual())
      ).data.rol;
    }

    // 0. Nota P5 — la autorización de ESCRITURAS vive en Server Actions
    // (Admin SDK, ignora reglas). Aquí: writes de cliente denegados en
    // sys_admin_users y sys_permissions_matrix; lecturas autenticadas
    // (AuthContext resuelve el rol propio por email para todos los roles).

    // 1. Reglas existentes para el panel nuevo y catálogo
    match /pagina/catalogo/items/{item} { allow read: if true; allow write: if request.auth != null; }
    match /leads/{lead} { allow create: if true; allow read, update, delete: if request.auth != null; }
    match /prospectos/{document} { allow create: if true; allow read, update, delete: if request.auth != null; }
    match /sys_admin_users/{document} {
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && get(/databases/$(database)/documents/sys_admin_users/$(request.auth.token.email)).data.rol in ['admin', 'superadmin', 'auditor'];
      allow write: if false;
    }
    match /sys_permissions_matrix/{document} { allow read: if true; allow write: if false; }

    // 2. Desbloqueo para el Panel Viejo (Legacy)
    // Agregamos 'configuracion' y 'settings' que son vitales para los formularios
    match /usuarios/{document=**} { allow read: if request.auth != null; }
    match /sedes/{document=**} { allow read: if true; }
    match /sucursales/{document=**} { allow read: if true; }
    match /imported_tables/{document=**} { allow read: if request.auth != null; }
    match /configuracion/general/sedes/{document=**} { allow read: if true; allow write: if request.auth != null; }
    match /configuracion/general_info { allow read: if true; allow write: if request.auth != null; }
    match /configuracion/{document=**} { allow read: if request.auth != null; allow write: if request.auth != null; }
    match /settings/{document=**} { allow read: if true; }
    match /config/{document=**} { allow read: if true; allow write: if false; }
    match /panel/{document=**} { allow read: if request.auth != null; }
    match /tables/{document=**} { allow read: if request.auth != null; }
    
    // Formularios: moto_ideal público, el resto privado
    match /formularios/moto_ideal { allow read: if true; }
    match /formularios/{document=**} { allow read: if request.auth != null; }

    match /labels/{document=**} { allow read: if true; }
    match /etiquetas/{document=**} { allow read: if true; }
    match /traducciones/{document=**} { allow read: if request.auth != null; }
    match /ui_texts/{document=**} { allow read: if true; }
    match /financial_config/{document=**} { allow read: if true; allow write: if request.auth != null; }

    // Reglas de Anomalías y Alertas (SSOT v8.4.1 - v8.4.4)
    match /anomalias/{document} { allow read, write: if request.auth != null; }
    match /sys_alerts/{document} { allow read, write: if request.auth != null; }

    // 3. Módulo de Gestión de Créditos y Renting (Fase 9) — NAMING LOCK
    // Todas las escrituras viajan por Server Actions (Admin SDK, ignora reglas).
    // La base de datos RECHAZA delete (inmutabilidad financiera, Sección 2.C).
    match /clientes_credito/{document}    { allow read: if request.auth != null; allow create, update, delete: if false; }
    match /creditos/{document}            { allow read: if request.auth != null; allow create, update, delete: if false; }
    match /pagos_y_multas/{document}      { allow read: if request.auth != null; allow create, update, delete: if false; }
    match /pagos_inversores/{document}    { allow read: if request.auth != null; allow create, update, delete: if false; }
    match /remisiones_dinero/{document}   { allow read: if request.auth != null; allow create, update, delete: if false; }
    match /historial_auditoria/{document} { allow read: if request.auth != null; allow create, update, delete: if false; }

    // 4. Inventario de repuestos (WEB-038) — NAMING LOCK
    // Escrituras solo por Server Actions (Admin SDK). Cliente: solo lectura.
    match /conteos_pendientes_repuestos/{conteo} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && (
          rolActual() in ['superadmin', 'admin', 'auditor']
          || resource.data.asesor_email == emailActual()
        );
      allow create, update, delete: if false;
    }

    match /inventario_repuestos/{repuesto} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && rolActual() in ['superadmin', 'admin', 'asesor', 'auditor'];
      allow create, update, delete: if false;
    }

    match /fotos_inventario/{foto} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && (
          rolActual() in ['superadmin', 'admin', 'auditor']
          || resource.data.asesor_email == emailActual()
        );
      allow create, update, delete: if false;
    }

    match /historial_auditoria_inventario/{asiento} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && rolActual() in ['superadmin', 'admin', 'auditor', 'asesor'];
      allow create, update, delete: if false;
    }

    // Regla de seguridad por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
